{
  "name": "soulsilent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:apply": "wrangler d1 execute soulsilent --local --file=schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply soulsilent --local",
    "db:migrate:remote": "wrangler d1 migrations apply soulsilent --remote",
    "db:seed": "wrangler d1 execute soulsilent --local --file=seed.sql",
    "db:reset": "wrangler d1 execute soulsilent --local --file=schema.sql && wrangler d1 execute soulsilent --local --file=seed.sql"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260521.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "bcryptjs": "^3.0.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "next": "16.2.6",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.0.10",
    "resend": "^6.12.4",
    "stripe": "^22.1.1",
    "thai-address-database": "^0.0.30",
    "uuid": "^14.0.0",
    "wrangler": "^4.93.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
